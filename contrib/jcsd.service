[Unit]
Description=JC Studio daemon (multi-agent console orchestrator)
Documentation=https://github.com/jhotis/jc-studio
# The backend is a dependency for execution, but not for the daemon to boot:
# status and history must stay available when OpenCode is down.
After=network.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/jcsd
Restart=on-failure
RestartSec=3s
# The daemon owns durable state; a hard kill is survivable (stale runs are recovered
# and parked), but a clean stop is preferred so the WAL can be checkpointed.
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening that does not break the product:
#   * `strict`/`read-only` made OpenCode's own log write fail (it runs as a dependency of
#     the daemon) and would make git promotion into repositories under $HOME impossible.
#   * `full` keeps the system directories read-only while leaving the user's repositories
#     and OpenCode state writable, which is exactly what the daemon operates on.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=%h/.local/share/jcs
StateDirectory=jcs
RuntimeDirectory=jcs

[Install]
WantedBy=default.target
